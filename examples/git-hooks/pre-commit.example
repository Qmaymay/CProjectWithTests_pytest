#!/bin/bash
# ==================================================
# 自动化版本管理 Pre-commit 钩子
# 位置: .git/hooks/pre-commit (需设置为可执行)
# 功能: 根据代码变更自动更新版本号
# ==================================================

echo "🚀 开始pre-commit检查..."

# 切换到项目根目录
cd "$(git rev-parse --show-toplevel)"

# ==================== 第一部分：C版本检查 ====================

echo "🔧 检测C版本修改的文件..."
git diff --cached --name-only

# 更可靠的检测方式
if git diff --cached --name-only | grep "calculator.h" > /dev/null; then
    echo "🚀 检测到API变化，按新增功能处理"
    
    # 直接在钩子里更新C版本
    cd calculator
    python -c "
import re
with open('version.h', 'r', encoding='utf-8') as f:
    content = f.read()

# 提取当前版本号
major = int(re.search(r'CALC_MAJOR_VERSION\\s+(\\d+)', content).group(1))
minor = int(re.search(r'CALC_MINOR_VERSION\\s+(\\d+)', content).group(1))

# 次版本+1
new_minor = minor + 1

print(f'当前版本: {major}.{minor}.0')
print(f'更新版本: {major}.{new_minor}.0')

# 更新文件
new_content = re.sub(r'#define CALC_MINOR_VERSION\\s+\\d+', f'#define CALC_MINOR_VERSION {new_minor}', content)
new_content = re.sub(r'#define CALC_VERSION\\s+\\\"[0-9]+\\.[0-9]+\\.[0-9]+\\\"', f'#define CALC_VERSION \\\"{major}.{new_minor}.0\\\"', new_content)

with open('version.h', 'w', encoding='utf-8') as f:
    f.write(new_content)

print(f'✅ C版本更新: {major}.{minor}.0 → {major}.{new_minor}.0')
"
    cd ..
    
    git add calculator/version.h
else
    echo "🐛 检测到代码修改，按Bug修复处理"
    echo "✅ Bug修复：C版本保持不变"
    git add calculator/version.h
fi

# ==================== 第二部分：测试版本检查 ====================
echo "🔍 运行测试版本检查..."

# 检查是否存在测试目录和版本管理文件
if [ -f "calculator_tests/auto_test_version.py" ]; then
    # 运行自动化版本管理
    python calculator_tests/auto_test_version.py
else
    echo "⚠️  未找到版本管理脚本，跳过版本检查"
fi

echo "✅ 所有检查完成"